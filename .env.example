# Site URL (used for SEO canonical, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://sgliving.life

# Telegram Bot Token — create at https://t.me/BotFather
# Steps: /newbot → follow prompts → copy token
TELEGRAM_BOT_TOKEN=

# Telegram channel to pull #deals posts from (default: @sgfooddeals)
TELEGRAM_CHANNEL_ID=@sgfooddeals

# Telegram channel for Singapore airline deals (set to a real channel username)
AIRLINE_CHANNEL=sgairlinedeals
